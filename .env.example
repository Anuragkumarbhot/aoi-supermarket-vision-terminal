# Optional external sales sync. Leave both values unset to keep sync disabled.
# The endpoint must use HTTPS.
AOI_SALES_SYNC_URL=
AOI_SALES_SYNC_TOKEN=

# Local dashboard binding. Non-localhost values are intentionally rejected.
AOI_HOST=127.0.0.1
AOI_PORT=5000

# Optional operator login. Set BOTH values to enable HTTP Basic authentication.
# Use a unique, strong password; do not commit real values.
AOI_AUTH_USERNAME=operator
AOI_AUTH_PASSWORD=
